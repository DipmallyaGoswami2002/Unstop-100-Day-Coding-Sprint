Problem Statement
You are given an array A of size N.

Your task is to count the number of unique pairs of non-overlapping subarrays such that both subarrays have the same sum.

Each subarray is defined by a pair of indices [L, R] (1-based indexing), where 1 ≤ L ≤ R ≤ N.

Two subarrays must not overlap, meaning they should not share any common index.

Also, the pair ([L1, R1], [L2, R2]) is considered the same as ([L2, R2], [L1, R1]), so count each valid pair only once.

Solution : 
// Code
#include <iostream>
#include <vector>
#include <unordered_map>
#include <algorithm>

using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (!(cin >> n)) return 0;

    vector<long long> a(n);
    for (int i = 0; i < n; ++i) {
        cin >> a[i];
    }
    vector<long long> pref(n + 1, 0);
    for (int i = 0; i < n; ++i) {
        pref[i + 1] = pref[i] + a[i];
    }
    unordered_map<long long, vector<int>> sum_to_ends;

    long long total_pairs = 0;

    for (int r = 1; r <= n; ++r) {
        for (int l = 1; l <= r; ++l) {
            long long current_sum = pref[r] - pref[l - 1];

            if (sum_to_ends.count(current_sum)) {
                const auto& ends = sum_to_ends[current_sum];
                auto it = lower_bound(ends.begin(), ends.end(), l);
                total_pairs += distance(ends.begin(), it);
            }
            sum_to_ends[current_sum].push_back(r);
        }
    }
    cout << total_pairs << "\n";
    return 0;
